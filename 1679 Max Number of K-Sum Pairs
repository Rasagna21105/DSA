class Solution:
    def maxOperations(self, nums: List[int], k: int) -> int:
        # nums.sort()
        # l=0
        # r=len(nums)-1
        # cnt=0
        # while l<r:
        #     if nums[l]+nums[r]==k:
        #         cnt+=1
        #         l+=1
        #         r-=1
        #     elif nums[l]+nums[r]<k:
        #         l+=1
        #     else:
        #         r-=1
        # return cnt

        m={}
        s=0
        for num in nums:
            if num>k:
                continue
            if num not in m:
                m[num]=1
            else:
                m[num]+=1
        for i in m.keys():
            a=m[i]
            b=0
            if k-i in m:
                b=m[k-i]
            if i==k//2 and k%2==0:
                s+=2*(a//2)
            else:
                s+=min(a,b)
        return s//2