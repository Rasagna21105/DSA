class Solution:
    def mostPoints(self, questions: List[List[int]]) -> int:
        n=len(questions)
        dp=[0]*(n+1)
        for i in range(n-1,-1,-1):
            nottake=dp[i+1]
            points,brainpower=questions[i]
            nxt=i+brainpower+1
            take=points
            if nxt<n:
                take+=dp[nxt]
            dp[i]=max(take,nottake)
        return dp[0]